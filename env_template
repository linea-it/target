# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython

DJANGO_DEBUG=True
DJANGO_UWSGI_WORKER_PROCESSES=4
DJANGO_UWSGI_WORKER_THREADS=2
DATABASE_URL=postgres://debug:debug@postgres-14:5432/target
DATABASE_MYDB_URL=postgres://debug:debug@postgres-18:5432/catalogsdb
# To test issue #197's materialization end-to-end locally, Canvas needs to
# read the same Postgres Daiquiri writes to (in staging/production they
# already share one physical server; in local dev each repo has its own).
# Point at the lsp_daiquiri catalog-database container's host-published
# port instead of the line above (adjust host/port/credentials/db name to
# match your local lsp_daiquiri/.env):
# DATABASE_MYDB_URL=postgres://postgres:postgres@host.docker.internal:5435/daiquiri_data
MYDB_SCHEMA_PREFIX=mydb_

# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Celery
# ------------------------------------------------------------------------------

# Flower
CELERY_FLOWER_USER=debug
CELERY_FLOWER_PASSWORD=debug

